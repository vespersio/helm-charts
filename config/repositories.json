{
  "schema": 1,
  "defaults": {
    "oci_root": "oci://ghcr.io/vespersio/helm-charts",
    "initial_mode": "all",
    "batch_size": 100
  },
  "repositories": [
    {
      "id": "descheduler",
      "name": "Descheduler",
      "url": "https://kubernetes-sigs.github.io/descheduler/",
      "destination": "descheduler",
      "enabled": true,
      "include": [
        "descheduler"
      ],
      "exclude": []
    },
    {
      "id": "external-dns",
      "name": "ExternalDNS",
      "url": "https://kubernetes-sigs.github.io/external-dns/",
      "destination": "external-dns",
      "enabled": true,
      "include": [
        "external-dns"
      ],
      "exclude": []
    },
    {
      "id": "grafana",
      "name": "Grafana",
      "url": "https://grafana.github.io/helm-charts",
      "destination": "grafana",
      "enabled": true,
      "include": [
        "*"
      ],
      "exclude": []
    },
    {
      "id": "hashicorp",
      "name": "HashiCorp",
      "url": "https://helm.releases.hashicorp.com",
      "destination": "hashicorp",
      "enabled": true,
      "include": [
        "*"
      ],
      "exclude": []
    },
    {
      "id": "unleash",
      "name": "Unleash",
      "url": "https://docs.getunleash.io/helm-charts",
      "destination": "unleash",
      "enabled": true,
      "include": [
        "*"
      ],
      "exclude": []
    },
    {
      "id": "sentry-kubernetes",
      "name": "Sentry Kubernetes",
      "url": "https://sentry-kubernetes.github.io/charts",
      "destination": "sentry-kubernetes",
      "enabled": true,
      "include": [
        "*"
      ],
      "exclude": []
    },
    {
      "id": "harbor",
      "name": "Harbor",
      "url": "https://helm.goharbor.io",
      "destination": "harbor",
      "enabled": true,
      "include": [
        "harbor"
      ],
      "exclude": []
    },
    {
      "id": "gitlab",
      "name": "GitLab",
      "url": "https://charts.gitlab.io",
      "destination": "gitlab",
      "enabled": true,
      "include": [
        "*"
      ],
      "exclude": []
    },
    {
      "id": "elastic",
      "name": "Elastic",
      "url": "https://helm.elastic.co",
      "destination": "elastic",
      "enabled": true,
      "include": [
        "*"
      ],
      "exclude": []
    },
    {
      "id": "fairwinds",
      "name": "Fairwinds",
      "url": "https://charts.fairwinds.com/stable",
      "destination": "fairwinds",
      "enabled": true,
      "include": [
        "*"
      ],
      "exclude": []
    }
  ]
}
